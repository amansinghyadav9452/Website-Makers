# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/website-makers?retryWrites=true&w=majority

# Admin auth (use ADMIN_PASSWORD_HASH in production, generated via scripts/hash-password.js)
ADMIN_EMAIL=admin@sitesmaker.online
ADMIN_PASSWORD=your-secure-password-here
ADMIN_PASSWORD_HASH=

# JWT (used for both admin and client tokens)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
# Legacy fallback (will be deprecated in v2.0)
# ADMIN_JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long

# CORS
ALLOWED_ORIGINS=https://sitesmaker.online,https://www.sitesmaker.online,http://localhost:5173

# SMTP (optional — for inquiry email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Environment
NODE_ENV=production
