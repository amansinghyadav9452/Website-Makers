MONGODB_URI=mongodb+srv://...
PORT=4000
ALLOWED_ORIGINS=https://your-frontend.onrender.com

# Admin authentication
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
ADMIN_JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_32_PLUS_CHAR_SECRET

# SMTP for customer replies
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Website Makers <no-reply@yourdomain.com>
SMTP_REPLY_TO=admin@yourdomain.com
