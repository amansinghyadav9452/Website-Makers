# Server-only secrets. NEVER commit a real .env file.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/website_makers
PORT=4000

# Exact browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,https://sitesmaker.online,https://www.sitesmaker.online

ADMIN_EMAIL=admin@example.com
# Preferred: generate with `npm run hash-admin-password -- "your-password"`
ADMIN_PASSWORD_HASH=scrypt$REPLACE_SALT$REPLACE_HASH
# Temporary migration fallback only. Remove after setting ADMIN_PASSWORD_HASH.
# ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

ADMIN_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
CLIENT_JWT_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Website Makers <noreply@example.com>
SMTP_REPLY_TO=websitemaker695@gmail.com
ADMIN_NOTIFY_EMAIL=websitemaker695@gmail.com
